# Model config for machines without a .env: 9router (localhost, no key needed) + local Ollama embeddings.
# run.sh loads this file when it exists; variables set here override .env (process env wins).
LLM_BINDING=openai
LLM_BINDING_HOST=http://localhost:20128/v1
LLM_BINDING_API_KEY=local
# gemini flash-lite / cf llama-3.3-70b / cf mistral-small hit their free limits on 2wiki_n300 (Oct 29); switched to:
LLM_MODEL=kc/reflection/beam-free
# Spread calls over all models (each call starts at the next model); a rate-limited model is skipped
LLM_ROUTING=roundrobin
# On rate limit / error the server walks this chain (failed model cooled down 60 s); all free models via 9router
LLM_FAILOVER_MODELS=cl/reflection/beam-free,kc/kilo-auto/free,kgw/kilo-auto/free,xkiro/qwen/qwen3.5-flash:free,xkiro/qwen/qwen3.7-flash:free,agnes/agnes-2.5-flash,openrouter/xingchen-agi/xing4.0-29b-a4b:free,nvidia/nvidia/nemotron-3-ultra-550b-a55b
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RERANK_BINDING=null
# slow reasoning models (~10-60 s/call): more documents in flight instead of waiting
MAX_ASYNC=32
MAX_PARALLEL_INSERT=24
SUMMARY_LANGUAGE=English
# Pick KG chunks by entity order (WEIGHT), not by query similarity (VECTOR): with VECTOR the chunk
# order ignores entity scores, so PPR's re-scoring could never show up in passage recall.
KG_CHUNK_PICK_METHOD=WEIGHT
