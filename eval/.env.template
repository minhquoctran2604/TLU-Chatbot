# =============================================================================
# LightRAG .env Template for SSH Server (Linux)
# Copy this to ~/LightRAG/.env on server and fill in <PLACEHOLDER> values.
# =============================================================================

# --- 9router proxy (running locally on server, port 20128) ---
LLM_BINDING=openai
LLM_BINDING_HOST=http://localhost:20128/v1
LLM_BINDING_API_KEY=<FILL_9ROUTER_API_KEY_FROM_SERVER>
LLM_MODEL=gh/gpt-4o-mini
LLM_MODEL_EXTRACT=gc/gemini-3-flash-preview

# --- LLM failover chain (used by query path on 429/quota) ---
LLM_FAILOVER_MODELS=gh/gpt-4o-mini,gh/gpt-4o,gh/claude-haiku-4.5,gc/gemini-3-flash-preview
LLM_COOLDOWN_SEC=60

# --- Embedding (local HF model, downloaded on first run) ---
EMBEDDING_BINDING=huggingface
EMBEDDING_MODEL=microsoft/harrier-oss-v1-270m
EMBEDDING_DIM=640

# --- Postgres Supabase (pooler, IPv4) ---
POSTGRES_HOST=aws-1-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.rlctksrsvggqjqkidxyi
POSTGRES_PASSWORD=<FILL_POSTGRES_PASSWORD>
POSTGRES_DATABASE=postgres
POSTGRES_WORKSPACE=lightrag

# --- Storage backends (Postgres for KV/DocStatus/Vector, graphml file for Graph) ---
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

# --- Working dir (Linux path!) — must contain graph_chunk_entity_relation.graphml ---
# Adjust to match your scp destination, e.g.:
#   WORKING_DIR=/home/tts/AI/aiQuoc/tlu_workspace
#   WORKING_DIR=/home/tts/tlu_workspace
WORKING_DIR=/home/tts/AI/aiQuoc/tlu_workspace

# --- Retrieval tuning ---
COSINE_THRESHOLD=0.35

# --- Rerank: Cohere ---
RERANK_BINDING=cohere
RERANK_BY_DEFAULT=true
RERANK_MODEL=rerank-v3.5
RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
RERANK_BINDING_API_KEY=<FILL_COHERE_API_KEY>
MIN_RERANK_SCORE=0.3

# --- Concurrency (conservative for shared LLM proxy + PG pool) ---
MAX_ASYNC=3
MAX_PARALLEL_INSERT=1

# --- Misc ---
TOKEN_SECRET=a_very_secure_and_long_jwt_secret_key_123456789
